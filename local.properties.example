# Local properties for API keys and sensitive configuration
# DO NOT commit this file to version control
# Create a copy and fill in your actual credentials

# Android SDK
sdk.dir=/path/to/Android/sdk

# Music API Configuration
MUSIC_API_KEY=your_music_api_key_here
MUSIC_API_SECRET=your_music_api_secret_here
MUSIC_API_URL=https://api.example.com

# YouTube Configuration
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_CLIENT_ID=your_youtube_client_id.apps.googleusercontent.com

# Firebase (if using)
FIREBASE_PROJECT_ID=your_firebase_project_id

# Database
DB_PASSWORD=your_db_password

# Build Configuration
BUILD_TYPE=debug
TARGET_API_LEVEL=34
