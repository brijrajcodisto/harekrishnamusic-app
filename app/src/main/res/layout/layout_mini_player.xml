<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/miniPlayerCard"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:background="?attr/colorSurface"
    app:cardCornerRadius="0dp"
    app:cardElevation="8dp"
    app:cardUseCompatPadding="false"
    android:foreground="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp">

        <!-- Album Art -->
        <ImageView
            android:id="@+id/miniAlbumArt"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:scaleType="centerCrop"
            android:contentDescription="@string/now_playing_album_art"
            android:background="@drawable/bg_album_placeholder"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:src="@drawable/bg_album_placeholder" />

        <!-- Playing Animation Indicator -->
        <ImageView
            android:id="@+id/miniPlayingIndicator"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_equalizer"
            android:tint="@color/primary"
            android:visibility="gone"
            android:contentDescription="@string/now_playing_indicator"
            app:layout_constraintStart_toStartOf="@id/miniAlbumArt"
            app:layout_constraintEnd_toEndOf="@id/miniAlbumArt"
            app:layout_constraintTop_toTopOf="@id/miniAlbumArt"
            app:layout_constraintBottom_toBottomOf="@id/miniAlbumArt"
            android:background="@drawable/bg_playing_indicator" />

        <!-- Song Info -->
        <TextView
            android:id="@+id/miniSongTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Song Title"
            android:textSize="14sp"
            android:textColor="@color/onSurface"
            android:maxLines="1"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:singleLine="true"
            app:layout_constraintStart_toEndOf="@id/miniAlbumArt"
            app:layout_constraintTop_toTopOf="@id/miniAlbumArt"
            app:layout_constraintEnd_toStartOf="@id/miniPlayPause"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/miniArtist"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Artist Name"
            android:textSize="12sp"
            android:textColor="@color/onSurfaceVariant"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintStart_toEndOf="@id/miniAlbumArt"
            app:layout_constraintTop_toBottomOf="@id/miniSongTitle"
            app:layout_constraintEnd_toStartOf="@id/miniNext"
            android:layout_marginStart="12dp"
            android:layout_marginTop="2dp" />

        <!-- Progress Bar (Optional - shows when expanded) -->
        <ProgressBar
            android:id="@+id/miniProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:progress="30"
            android:progressTint="@color/primary"
            android:visibility="gone"
            app:layout_constraintStart_toEndOf="@id/miniAlbumArt"
            app:layout_constraintEnd_toStartOf="@id/miniPlayPause"
            app:layout_constraintTop_toBottomOf="@id/miniArtist"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp" />

        <!-- Play/Pause Button -->
        <ImageButton
            android:id="@+id/miniPlayPause"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_pause"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/play_pause"
            app:layout_constraintEnd_toStartOf="@id/miniNext"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginEnd="4dp" />

        <!-- Next Button -->
        <ImageButton
            android:id="@+id/miniNext"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_next"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/next_song"
            app:layout_constraintEnd_toStartOf="@id/miniExpand"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Expand/Collapse Button -->
        <ImageButton
            android:id="@+id/miniExpand"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_expand"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/expand_player"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Favorite Button (Optional - shows on long press/swipe) -->
        <ImageButton
            android:id="@+id/miniFavorite"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_favorite_border"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/add_to_favorites"
            android:visibility="gone"
            app:layout_constraintEnd_toStartOf="@id/miniPlayPause"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Queue/Up Next Badge -->
        <TextView
            android:id="@+id/miniQueueBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+5"
            android:textSize="10sp"
            android:textColor="@color/onPrimary"
            android:paddingHorizontal="4dp"
            android:paddingVertical="2dp"
            android:background="@drawable/bg_queue_badge"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="@id/miniAlbumArt"
            app:layout_constraintTop_toTopOf="@id/miniAlbumArt"
            android:layout_marginTop="-4dp"
            android:layout_marginEnd="-4dp" />

        <!-- Live/DJ Badge -->
        <TextView
            android:id="@+id/miniLiveBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LIVE"
            android:textSize="8sp"
            android:textColor="@color/error"
            android:paddingHorizontal="4dp"
            android:paddingVertical="1dp"
            android:background="@drawable/bg_live_badge"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@id/miniAlbumArt"
            app:layout_constraintTop_toTopOf="@id/miniAlbumArt"
            android:layout_marginStart="4dp"
            android:layout_marginTop="4dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>