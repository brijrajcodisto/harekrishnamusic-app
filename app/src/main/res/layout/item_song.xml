<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:background="?attr/selectableItemBackground"
    android:paddingStart="16dp"
    android:paddingEnd="8dp"
    android:clickable="true"
    android:focusable="true">

    <!-- Album Art Thumbnail -->
    <ImageView
        android:id="@+id/albumArt"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:scaleType="centerCrop"
        android:contentDescription="@string/song_album_art"
        android:background="@drawable/bg_album_placeholder"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:src="@drawable/bg_album_placeholder" />

    <!-- Song Title -->
    <TextView
        android:id="@+id/songTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Song Title"
        android:textSize="16sp"
        android:textColor="@color/onSurface"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintStart_toEndOf="@id/albumArt"
        app:layout_constraintTop_toTopOf="@id/albumArt"
        app:layout_constraintEnd_toStartOf="@id/btnFavorite"
        android:layout_marginStart="12dp" />

    <!-- Artist Name -->
    <TextView
        android:id="@+id/artistName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Artist Name"
        android:textSize="14sp"
        android:textColor="@color/onSurfaceVariant"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintStart_toEndOf="@id/albumArt"
        app:layout_constraintTop_toBottomOf="@id/songTitle"
        app:layout_constraintEnd_toStartOf="@id/tvDuration"
        android:layout_marginStart="12dp"
        android:layout_marginTop="2dp" />

    <!-- Album Name (Optional) -->
    <TextView
        android:id="@+id/albumName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Album Name"
        android:textSize="12sp"
        android:textColor="@color/onSurfaceVariant"
        android:maxLines="1"
        android:ellipsize="end"
        android:visibility="gone"
        app:layout_constraintStart_toEndOf="@id/albumArt"
        app:layout_constraintTop_toBottomOf="@id/artistName"
        app:layout_constraintEnd_toStartOf="@id/tvDuration"
        android:layout_marginStart="12dp"
        android:layout_marginTop="2dp" />

    <!-- Duration -->
    <TextView
        android:id="@+id/tvDuration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="3:45"
        android:textSize="14sp"
        android:textColor="@color/onSurfaceVariant"
        app:layout_constraintEnd_toStartOf="@id/btnMore"
        app:layout_constraintTop_toTopOf="@id/albumArt"
        app:layout_constraintBottom_toTopOf="@id/artistName"
        android:layout_marginEnd="12dp" />

    <!-- Favorite Button -->
    <ImageButton
        android:id="@+id/btnFavorite"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_favorite_border"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/add_to_favorites"
        app:layout_constraintEnd_toStartOf="@id/tvDuration"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- More Options Button -->
    <ImageButton
        android:id="@+id/btnMore"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_more"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/more_options"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Playing Indicator (Visible when song is playing) -->
    <ImageView
        android:id="@+id/playingIndicator"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_equalizer"
        android:tint="@color/primary"
        android:visibility="gone"
        android:contentDescription="@string/now_playing"
        app:layout_constraintStart_toStartOf="@id/albumArt"
        app:layout_constraintEnd_toEndOf="@id/albumArt"
        app:layout_constraintTop_toTopOf="@id/albumArt"
        app:layout_constraintBottom_toBottomOf="@id/albumArt"
        android:background="@drawable/bg_playing_indicator" />

    <!-- Divider -->
    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/outlineVariant"
        app:layout_constraintStart_toStartOf="@id/songTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>