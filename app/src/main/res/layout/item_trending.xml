<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="160dp"
    android:layout_height="200dp"
    android:layout_marginEnd="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardUseCompatPadding="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/trendingImage"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:scaleType="centerCrop"
            android:contentDescription="@string/trending_item"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@drawable/bg_album_placeholder" />

        <TextView
            android:id="@+id/trendingTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Trending Playlist"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/onSurface"
            app:layout_constraintTop_toBottomOf="@id/trendingImage"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="12dp"
            android:layout_marginHorizontal="8dp" />

        <TextView
            android:id="@+id/trendingSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Playlist • 50 songs"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/onSurfaceVariant"
            app:layout_constraintTop_toBottomOf="@id/trendingTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="4dp"
            android:layout_marginHorizontal="8dp" />

        <!-- Badge for trending -->
        <com.google.android.material.chip.Chip
            android:id="@+id/trendingBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Trending"
            style="@style/Widget.Material3.Chip.Filter"
            android:textSize="10sp"
            app:chipBackgroundColor="@color/primaryContainer"
            app:chipStrokeColor="@color/primary"
            app:chipStrokeWidth="1dp"
            app:layout_constraintTop_toTopOf="@id/trendingImage"
            app:layout_constraintEnd_toEndOf="@id/trendingImage"
            android:layout_margin="8dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>